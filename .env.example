# See: python scripts/what_agents_need.py
# Core
VERIDIQ_JWT_SECRET=veridiq-local-dev-secret-change-me
VERIDIQ_JWT_EXPIRE_HOURS=24
VERIDIQ_BACKEND_PORT=8001
VERIDIQ_FRONTEND_PORT=5173
VERIDIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
VERIDIQ_MAX_UPLOAD_MB=25
# Per-client-IP request budget for the dashboard API. A single live dashboard
# session legitimately opens several polling/SSE pages at once (workforce, ops,
# system, dashboard, collaboration...); 120/60s was tuned for a single
# request-per-minute integration test, not an interactive UI, and produced a
# 429 storm under normal use. CORS preflight (OPTIONS) and SSE streams are
# always exempt regardless of this value — see app.py.
VERIDIQ_RATE_LIMIT=1200
VERIDIQ_RATE_WINDOW=60

# Dynamic AI worker pool
VERIDIQ_WORKER_MIN=2
VERIDIQ_WORKER_MAX=50
# Floor (seconds) a worker stays visibly "busy" after a real agent run finishes,
# so the Agent Workspace / Live pages (SSE ~2s cadence, dashboard polls ~3-4s)
# can actually observe the run instead of it completing inside one request and
# looking permanently idle. Set to 0 to disable (e.g. in fast unit tests).
VERIDIQ_MIN_VISIBLE_SEC=6
# Marketing agents stay visibly busy longer so Live Runtime / Marketing
# SSE (~2s) can show drafting/queue stages after a team run.
VERIDIQ_MARKETING_MIN_VISIBLE_SEC=18

# --- External data connectors (optional; official APIs only) ---
# NewsAPI — required for live headlines on News page / connectors
# Get a key at https://newsapi.org/
VERIDIQ_NEWSAPI_KEY=
# NEWS_API_KEY=

# Research / web search (official HTTP APIs)
# Tavily — https://docs.tavily.com/
# VERIDIQ_TAVILY_API_KEY=
# SerpAPI — https://serpapi.com/search-api
# VERIDIQ_SERPAPI_API_KEY=
# Exa — https://docs.exa.ai/
# VERIDIQ_EXA_API_KEY=

# Jobs connector uses Remotive public API (no key required when reachable)

# --- Market Intelligence ---
# CoinGecko public markets/history work without a key.
# Optional demo/pro key (CG-... demo uses x-cg-demo-api-key):
# VERIDIQ_COINGECKO_API_KEY=
# VERIDIQ_CG_DEMO_API_KEY=
# Optional CoinMarketCap:
# VERIDIQ_CMC_API_KEY=
# VERIDIQ_MEXC_API_KEY=

# --- Blockchain readiness (do not deploy until addresses are set) ---
VERIDIQ_CHAIN_NETWORK=hardhat
VERIDIQ_RPC_URL=http://127.0.0.1:8545
# VERIDIQ_WALLET_ADDRESS=
# VERIDIQ_DEPLOYER_PRIVATE_KEY=
# VERIDIQ_CONTRACT_TRUTHATTESTATION=
# VERIDIQ_CONTRACT_WORKFORCETOKEN=

# --- Platform integrations (optional; official APIs only, never scraping) ---
# Missing values report status=configuration_required — no fabricated live activity.

# LinkedIn — official OAuth 2.0 app (https://learn.microsoft.com/linkedin/)
# Posting (share_post) requires w_member_social scope on the access token.
# VERIDIQ_LINKEDIN_CLIENT_ID=
# VERIDIQ_LINKEDIN_CLIENT_SECRET=
# VERIDIQ_LINKEDIN_ACCESS_TOKEN=
# Optional — set if the token's OpenID `sub` doesn't resolve to a postable member URN.
# VERIDIQ_LINKEDIN_PERSON_URN=

# X / Twitter — official API v2 (https://developer.x.com/)
# App-only bearer token (read-only: user lookup, search):
# VERIDIQ_X_BEARER_TOKEN=
# VERIDIQ_X_TEST_USERNAME=veridiq
# OAuth 1.0a user-context credentials, required to post tweets (POST /2/tweets):
# VERIDIQ_X_API_KEY=
# VERIDIQ_X_API_SECRET=
# VERIDIQ_X_ACCESS_TOKEN=
# VERIDIQ_X_ACCESS_TOKEN_SECRET=

# Instagram — official Instagram Graph API (business accounts only)
# VERIDIQ_INSTAGRAM_ACCESS_TOKEN=
# Publishing (media_publish) also requires the Business Account id:
# VERIDIQ_INSTAGRAM_USER_ID=

# Threads — official Meta Threads API (https://developers.facebook.com/docs/threads/)
# Preferred live-test path when LinkedIn Developer Portal is gated.
# Create App → add Threads use case → permissions threads_basic + threads_content_publish
# App ID/Secret are for OAuth helper only (scripts/threads_exchange_code.py).
# Posting still requires a user access token + Threads user id:
# VERIDIQ_THREADS_APP_ID=
# VERIDIQ_THREADS_APP_SECRET=
# Preferred alternate (error 1349168): Postman OAuth HTTPS callback — see scripts/THREADS_TOKEN_HELP.md
#   VERIDIQ_THREADS_REDIRECT_URI=https://oauth.pstmn.io/v1/callback
# Paste that exact URI into Threads Authorize callback URL AND Facebook Login → Valid OAuth Redirect URIs.
# Enable Facebook Login → Client OAuth Login + Web OAuth Login. Then open authorize URL, paste ?code=:
#   python scripts/threads_exchange_code.py <code> --write-env
#
# Or HTTPS tunnel:
#   npx ngrok http 5173   # needs: ngrok config add-authtoken <token>
#   OR: npx cloudflared tunnel --url http://127.0.0.1:5173
#   VERIDIQ_THREADS_REDIRECT_URI=https://YOUR_HOST/oauth/threads/callback
#
# Desktop bypass: Native or desktop app? ON + login_success.html (must match .env):
#   VERIDIQ_THREADS_REDIRECT_URI=https://www.facebook.com/connect/login_success.html
#
# VERIDIQ_THREADS_REDIRECT_URI=https://oauth.pstmn.io/v1/callback
# VERIDIQ_THREADS_ACCESS_TOKEN=
# VERIDIQ_THREADS_USER_ID=
# Authorize: https://threads.com/oauth/authorize?client_id=APP_ID&redirect_uri=...&scope=threads_basic,threads_content_publish,threads_manage_replies&response_type=code
# Callback UI: /oauth/threads/callback  |  CLI: python scripts/threads_exchange_code.py <code> --write-env
# Docs: https://developers.facebook.com/docs/threads/get-started/
# Publish: https://developers.facebook.com/docs/threads/posts/

# Telegram — official Bot API (create a bot via @BotFather)
# Prefer VERIDIQ_* names. Aliases also accepted: TELEGRAM_BOT_TOKEN / BOT_TOKEN,
# TELEGRAM_DEFAULT_CHAT_ID / TELEGRAM_CHAT_ID.
# VERIDIQ_TELEGRAM_BOT_TOKEN=
# Default broadcast target (channel/group chat id) used for marketing daily
# posts that have no per-post recipient_hint. Without it, approving a
# telegram marketing draft reports configuration_required — never fabricated.
# VERIDIQ_TELEGRAM_DEFAULT_CHAT_ID=
# Inbound group/DM auto-reply (long-polling getUpdates in the backend):
# VERIDIQ_TELEGRAM_AUTO_REPLY=1
# Set to 0 to disable. Defaults on when VERIDIQ_TELEGRAM_BOT_TOKEN is set.
# Welcome new group members by name (new_chat_members). Defaults on when token is set:
# VERIDIQ_TELEGRAM_WELCOME=1
# Bot must be a group admin. For join events under privacy mode, BotFather → /setprivacy → Disable.
# VERIDIQ_TELEGRAM_REPLY_ONLY_MENTIONS=0
# Set to 1 to reply only when @your_bot is mentioned (groups). Default answers any group text.
# Optional proxy when api.telegram.org is blocked on your network (also respects HTTPS_PROXY / HTTP_PROXY):
# VERIDIQ_TELEGRAM_PROXY=http://127.0.0.1:7890
# Delivery mode for dedicated cloud workers: longpoll (Fly/Render worker) | webhook (HTTPS web service)
# VERIDIQ_TELEGRAM_MODE=longpoll
# When a dedicated Fly/Render worker/webhook owns inbound updates, disable the embedded FastAPI poller:
# VERIDIQ_TELEGRAM_LISTENER_IN_API=0
# Webhook-only (public HTTPS). Full URL, or omit and use RENDER_EXTERNAL_URL + path on Render:
# VERIDIQ_TELEGRAM_WEBHOOK_URL=https://your-service.onrender.com/telegram/webhook
# VERIDIQ_TELEGRAM_WEBHOOK_SECRET=
# VERIDIQ_TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# 24/7 deploy (prefer Fly — cheaper / free-allowance friendly): docs/DEPLOY_TELEGRAM_FLY.md
# Render Background Worker (paid ~$7): docs/DEPLOY_TELEGRAM_RENDER.md
# On Fly, set secrets with: fly secrets set VERIDIQ_TELEGRAM_BOT_TOKEN=...  (never commit tokens)

# WhatsApp — official Meta WhatsApp Cloud API
# VERIDIQ_WHATSAPP_TOKEN=
# VERIDIQ_WHATSAPP_PHONE_NUMBER_ID=

# Email — SMTP (used only after explicit comms-draft approval)
# VERIDIQ_SMTP_HOST=
# VERIDIQ_SMTP_PORT=587
# VERIDIQ_SMTP_USER=
# VERIDIQ_SMTP_PASSWORD=
# VERIDIQ_SMTP_FROM=

# CRM — HubSpot (private app token) or a generic CRM key
# VERIDIQ_HUBSPOT_API_KEY=
# VERIDIQ_CRM_API_KEY=

# Marketing platform — generic official API key + operator-configured send webhook
# (provider base URL isn't fixed across marketing platforms, so VERIDIQ posts
# to your own official send/trigger webhook when both are set).
# VERIDIQ_MARKETING_API_KEY=
# VERIDIQ_MARKETING_WEBHOOK_URL=

# AI Calling — official Twilio Voice API (https://www.twilio.com/docs/voice)
# Campaigns are queued for explicit approval; no number is ever auto-dialed.
# VERIDIQ_TWILIO_ACCOUNT_SID=
# VERIDIQ_TWILIO_AUTH_TOKEN=
# VERIDIQ_TWILIO_FROM_NUMBER=

# --- Marketing Agency platforms (optional; official APIs only) ---
# Everything under /api/v1/veridiq/marketing/* works fully offline without
# these — campaigns, daily content packs, and video storyboards are always
# generated and queued as drafts. These vars only enable the *live send* half
# of the draft -> approve -> send gate (comms approve step) for marketing
# content, plus real Canva design creation and optional video rendering.
# Reuses the LinkedIn / X / Instagram / Threads / Telegram vars declared above for
# posting, replying, and commenting — no separate marketing-only social keys.
#
# Marketing Agency roster "Run now" checklist — clicking Run now on any
# marketing agent (or "Run marketing team now") always generates real content
# and queues it as a draft with zero setup. To go from draft -> a real post on
# each platform once you approve it, set:
#   Telegram      -> VERIDIQ_TELEGRAM_BOT_TOKEN + VERIDIQ_TELEGRAM_DEFAULT_CHAT_ID
#   X / Twitter   -> VERIDIQ_X_API_KEY + VERIDIQ_X_API_SECRET + VERIDIQ_X_ACCESS_TOKEN + VERIDIQ_X_ACCESS_TOKEN_SECRET
#   LinkedIn      -> VERIDIQ_LINKEDIN_ACCESS_TOKEN (+ VERIDIQ_LINKEDIN_PERSON_URN if needed)
#   Instagram     -> VERIDIQ_INSTAGRAM_ACCESS_TOKEN + VERIDIQ_INSTAGRAM_USER_ID
#   Threads       -> VERIDIQ_THREADS_ACCESS_TOKEN + VERIDIQ_THREADS_USER_ID
# Without a platform's vars, approving that platform's draft reports
# configuration_required — never a fabricated "sent".

# Canva — official Canva Connect API (https://www.canva.dev/docs/connect/)
# Used by POST /api/v1/veridiq/marketing/canva/design (design:content:write scope).
# VERIDIQ_CANVA_CLIENT_ID=
# VERIDIQ_CANVA_CLIENT_SECRET=
# VERIDIQ_CANVA_ACCESS_TOKEN=

# Video render provider — generic official render-trigger webhook.
# Storyboards/scripts/shot lists always generate offline; setting these two
# enables POST /api/v1/veridiq/marketing/video/render to submit a real render
# job to your chosen provider (e.g. Shotstack, Creatomate — bring your own).
# VERIDIQ_VIDEO_RENDER_API_KEY=
# VERIDIQ_VIDEO_RENDER_WEBHOOK_URL=

# --- Live Agent Runtime ---
# Optional Playwright browser session recorder. Disabled by default. When set to 1
# AND the `playwright` package + Chromium are installed, the Live Agent Runtime page
# can capture a screenshot of a single public URL you provide. It never scrapes data
# or automates logins. Without this flag, the runtime page shows the live activity
# stream + deep links only.
# VERIDIQ_BROWSER_RUNTIME=0

# Influencer Relations (Adrian) — same platform vars as above.
# Run now on influencer_relations queues hook/CTA-style drafts for
# Instagram + X + LinkedIn + Telegram. Approve via Marketing queue or
# POST /api/v1/veridiq/comms/approve to trigger the real platform send
# (configuration_required when credentials are missing — never fabricated).

# Human send cadence — optional jitter between batch approvals (not stealth;
# just avoids blasting 50 posts in one second). Set min/max to 0 in tests/CI.
# VERIDIQ_MARKETING_CADENCE_ENABLED=1
# VERIDIQ_MARKETING_SEND_JITTER_MIN_SEC=30
# VERIDIQ_MARKETING_SEND_JITTER_MAX_SEC=180

